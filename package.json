{
  "name": "event-manager",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && eslint src/app src/components src/lib src/db.ts src/proxy.ts && tsx scripts/timezone-check.ts && next build",
    "verify:db": "tsx scripts/rate-limit-check.ts --allow-writes && tsx scripts/rsvp-concurrency.ts --allow-writes"
  },
  "dependencies": {
    "@neon/config": "^1.8.4",
    "@neondatabase/auth": "^0.5.0-beta",
    "@prisma/adapter-neon": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^18.0.6",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
