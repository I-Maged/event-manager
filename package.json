{
  "name": "event-manager",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --project components",
    "test:watch": "vitest --project unit --project components",
    "test:db": "vitest run --project db",
    "test:http": "vitest run --project http",
    "test:e2e": "playwright test",
    "test:all": "npm run test && npm run test:db && npm run test:http && npm run test:e2e",
    "test:ci": "npm run test && npm run test:db",
    "db:test:base": "tsx scripts/test-db.ts base",
    "db:test:up": "tsx scripts/test-db.ts up",
    "db:test:down": "tsx scripts/test-db.ts down",
    "db:test:status": "tsx scripts/test-db.ts status",
    "verify": "npm run typecheck && eslint src/app src/components src/lib src/db.ts src/proxy.ts && tsx scripts/timezone-check.ts && tsx scripts/search-check.ts && next build",
    "verify:full": "npm run verify && npm run test:all",
    "verify:db": "npm run test:db"
  },
  "dependencies": {
    "@neon/config": "^1.8.4",
    "@neondatabase/auth": "^0.5.0-beta",
    "@prisma/adapter-neon": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^18.0.6",
    "next": "^16.4.3",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "jsdom": "^30.1.3",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.12"
  }
}
