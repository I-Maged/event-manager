generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// NOTE: CHECK constraints live only in the migration SQL — Prisma cannot
// express or introspect them. Never run `prisma db push` against this
// database: it would drop them. Schema changes ship as migrations.

// Managed Auth (Neon Auth) owns identity in the `neon_auth` schema.
// This app stores only domain data. `userId` is the Managed Auth user id
// (plain String, no FK) so auth state branches with the database.

model Event {
  id           String        @id @default(cuid())
  title        String
  description  String
  date         DateTime
  // IANA zone the organizer authored `date` in (e.g. "Europe/Berlin").
  // Null for rows created before timezone support -> render with APP_TIME_ZONE.
  timeZone     String?
  location     String
  // DB-level invariant (migration-only):
  //   CHECK ("maxAttendees" IS NULL OR "maxAttendees" > 0)
  maxAttendees Int?
  isPublic     Boolean       @default(true)
  category     EventCategory @default(OTHER)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Managed Auth user id of the organizer
  userId String

  // Denormalized display name stamped at create/update (Managed Auth has
  // no user-lookup API, so the id alone can't render a name).
  organizerName String?

  // Reusable private-invite token. Null = no active link. Unique so
  // /invite/[token] can resolve the event in one lookup.
  inviteToken String? @unique

  rsvps RSVP[]
  comments Comment[]
  notifications Notification[]

  @@index([userId, date])
  @@index([isPublic, date])
  @@index([category, date])
}

enum EventCategory {
  MUSIC
  SPORTS
  TECH
  ARTS
  FOOD
  WELLNESS
  COMMUNITY
  BUSINESS
  EDUCATION
  OTHER
}

model RSVP {
  id        String     @id @default(cuid())
  status    RSVPStatus
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Set when a WAITLISTED row is auto-promoted to GOING. Null otherwise.
  // Powers the "You got in!" banner; cleared on dismiss.
  promotedAt DateTime?

  // Denormalized display name stamped on RSVP write (same pattern as
  // Event.organizerName — Managed Auth has no user-lookup API).
  attendeeName String?

  // Set when the organizer checks the attendee in. Null = not checked in.
  checkedInAt DateTime?

  /// Managed Auth user id of the organizer who performed the check-in.
  checkedInBy String?

  // Opt-out for event-update and reminder notifications. True by default.
  notifyOnUpdate Boolean @default(true)

  // Managed Auth user id of the attendee
  userId  String
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
  @@index([eventId, status, createdAt])
}

enum RSVPStatus {
  GOING
  NOT_GOING
  MAYBE
  WAITLISTED
}

model Comment {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  authorName String?
  // DB-level invariant (migration-only):
  //   CHECK (char_length("body") <= 1000)
  body      String
  createdAt DateTime @default(now())

  @@index([eventId, createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  eventId   String?
  event     Event?           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

enum NotificationType {
  PROMOTION
  EVENT_UPDATED
  EVENT_CANCELLED
  COMMENT
  REMINDER
}

/// Fixed-window counters for per-user write limits. Postgres is the counter
/// store because this stack has no Redis. One row per `{scope}:{userId}` key.
model RateLimit {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now()) @db.Timestamptz(3)

  @@index([windowStart])
}
