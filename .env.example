# Copy to `.env` and fill in. Never commit real credentials.
#
# Postgres — pooled connection for the app (has `-pooler` in the host).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"
# Direct connection for Prisma CLI (migrations, introspection).
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# App-wide reference zone: fallback for legacy events (Event.timeZone = null),
# no-JS submits, and browse day boundaries ("Today", "Next 7 days").
# Set this in the deploy environment as well.
APP_TIME_ZONE="Europe/Berlin"

# Neon Auth — sign-in for the app (Managed Better Auth).
NEON_AUTH_BASE_URL="https://HOST.neonauth.REGION.aws.neon.tech/DB/auth"
NEON_AUTH_JWKS_URL="https://HOST.neonauth.REGION.aws.neon.tech/DB/auth/.well-known/jwks.json"
NEON_AUTH_COOKIE_SECRET=""
